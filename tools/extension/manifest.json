{
  "manifest_version": 3,
  "name": "MPV Media & Cookie Companion",
  "short_name": "MPV Companion",
  "version": "1.0",
  "description": "Seamless plug-and-play stream interception, Cloudflare cookie sync, and 1-click playback for MPV & yt-dlp",
  "permissions": [
    "cookies",
    "contextMenus",
    "nativeMessaging",
    "tabs",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.hanime.tv/*",
    "*://*.perverzija.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MPV Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}