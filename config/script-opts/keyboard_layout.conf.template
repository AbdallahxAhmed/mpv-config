# keyboard_layout.conf - make mpv's letter keys work under any layout.
#
# mpv matches a key binding against the CHARACTER a key produces, so with
# an Arabic (or any non-latin) layout active the letter bindings never
# fire. The guard translates the printable keys while mpv is focused and
# leaves the system layout, the taskbar indicator and every other
# application exactly as they were.
#
# enabled=no  -> do not start the guard
# command=... -> the command line (the installer writes it with the right
#                python path)
# log=...     -> where to write what was translated (empty = the config dir)
enabled=yes
command=
log=
