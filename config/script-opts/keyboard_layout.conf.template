# keyboard_layout.conf - the optional keyboard-layout guard hook.
#
# DISABLED BY DEFAULT: the Arabic layout twins in input.conf (regenerated
# by every mpv-config install/update, see src/mpv_config/layout_twins.py)
# cover the same problem with pure config - no hook process, no orphaned
# python.exe after mpv exits.
#
# Set enabled=yes to bring the hook back: while mpv is focused it
# translates printable keys to their US-layout characters, whatever the
# active layout is. Useful only for non-Latin layouts beyond Arabic 101.
#
# enabled=no  -> do not start the guard (default)
# command=... -> the command line (the installer writes it with the right
#                python path)
# log=...     -> where to write what was translated (empty = the config dir)
enabled=no
command=
log=
