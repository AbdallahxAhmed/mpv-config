# keyboard_layout.conf - configure keyboard layout support.
#
# Hardware scan-code helper via AutoHotkey (Windows):
# Active by default (ahk=yes). Translates physical keys when mpv is focused
# and Arabic layout is active, providing 1:1 hardware key parity for bare keys
# (h, b, g, etc.). Cleanly auto-terminates 2 seconds after mpv closes.
#
# On Linux / macOS, layout twins in input.conf handle Arabic mappings
# with pure config and zero runtime processes.
#
ahk=yes
enabled=no
command=
log=
