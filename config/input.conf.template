CTRL+6 no-osd change-list glsl-shaders set "~~/shaders/Anime4K_Clamp_Highlights.glsl{{SHADER_SEP}}~~/shaders/Anime4K_Upscale_Denoise_CNN_x2_VL.glsl{{SHADER_SEP}}~~/shaders/Anime4K_AutoDownscalePre_x2.glsl{{SHADER_SEP}}~~/shaders/Anime4K_AutoDownscalePre_x4.glsl{{SHADER_SEP}}~~/shaders/Anime4K_Restore_CNN_M.glsl{{SHADER_SEP}}~~/shaders/Anime4K_Upscale_CNN_x2_M.glsl"; show-text "Anime4K: Mode C+A (Denoise + Sharp)"

# **----- اختصار لإلغاء جميع المؤثرات -----**
CTRL+0 no-osd change-list glsl-shaders clr ""; show-text "Shaders Cleared"


# **----- اختصارات مفيدة إضافية (تم التصحيح) -----**

# F1: أخذ لقطة شاشة (Screenshot) بدون تضمين الترجمة.
F1 no-osd screenshot video

# F2: أخذ لقطة شاشة مع تضمين الترجمة.
F2 no-osd screenshot

# F3: تفعيل/تعطيل فلتر إزالة الشرائط اللونية (Debanding).
F3 cycle deband

# F4: تفعيل/تعطيل سلاسة الحركة (Interpolation).
F4 cycle interpolation

# F5: التبديل بين مسارات الصوت المتاحة.
F5 cycle audio

# F6: التبديل بين مسارات الترجمة المتاحة.
F6 cycle sub

# F7: إظهار/إخفاء الترجمة.
F7 cycle sub-visibility


# F8: تفعيل/تعطيل توحيد مستوى الصوت (Stable Volume / Night Mode)
# مفيد جداً في الأنمي والأفلام التي يكون فيها صوت الحوار منخفضاً والمؤثرات عالية
# f=500   : نافذة تحليل أطول = استجابة أهدأ، لا "تنفس" مسموع
# g=15    : أقصى رفع 15dB بدلاً من 31 — لا يضخم هسهسة الخلفية
# p=0.95  : هدف قمة قريب من المستوى الكامل، لا ضغط حاد نحو 50%
# m=10    : سقف لمعدل تغير الكسب لكل إطار — يقتل ضخّ الكسب المفاجئ
# alimiter: جدار حماية نهائي يمنع القص الرقمي عند رفع volume فوق 100%
F8 cycle-values af "lavfi=[dynaudnorm=f=500:g=15:p=0.95:m=10],lavfi=[alimiter=limit=0.9:level=false]" ""

# ── Window close ── ensure WM close button kills mpv instantly ──
CLOSE_WIN quit

# ── Mouse Bindings ── Restore classic right-click pause over native context menu
MBTN_RIGHT       cycle pause
MBTN_RIGHT_DBL   ignore

# Instant play from clipboard (with automatic URL normalization & instant OSD)
Ctrl+v           script-binding smart_paste/paste-to-open
Ctrl+V           script-binding smart_paste/paste-to-open
Ctrl+Shift+v     script-binding smart_paste/paste-to-playlist
Ctrl+Shift+V     script-binding smart_paste/paste-to-playlist

#######################################################################################
#                                   نهاية الإعدادات                                   #
#######################################################################################

# ─── Script Keybindings (conflict-free) ──────────────────────────

# History (memo) — h = History
h    script-binding memo-history

# SponsorBlock voting — B = Block (moved from h/H to avoid memo conflict)  
B    script-binding sponsorblock_upvote
Shift+B  script-binding sponsorblock_downvote

# Subtitle sync (autosubsync) — n = syNc
n    script-binding autosubsync-menu

# ─── Arabic Bilingual Twin Bindings (Arabic 101/102 Layout) ───────
# History (memo) — ا = h (History)
ا        script-binding memo-history

# SponsorBlock voting — ﻻ = B (Upvote), Shift+ﻻ / ﻵ = Shift+B (Downvote)
ﻻ        script-binding sponsorblock_upvote
Shift+ﻻ  script-binding sponsorblock_downvote
ﻵ        script-binding sponsorblock_downvote

# SponsorBlock segment marking / submission — ل = g, Shift+ل / إ = G
ل        script-binding sponsorblock_set_segment
Shift+ل  script-binding sponsorblock_submit_segment
إ        script-binding sponsorblock_submit_segment

# Explicit Latin bindings for SponsorBlock segment marking
g        script-binding sponsorblock_set_segment
G        script-binding sponsorblock_submit_segment

# Subtitle sync (autosubsync) — ى = n (syNc)
ى        script-binding autosubsync-menu

# Instant play from clipboard — Ctrl+ر = Ctrl+v
Ctrl+ر           script-binding smart_paste/paste-to-open
Ctrl+Shift+ر     script-binding smart_paste/paste-to-playlist
