# **----- اختصارات تبديل مؤثرات Anime4K -----**
#
# These go through scripts/profile_picker.lua, so the choice is applied
# AND remembered (script-opts/anime4k.conf). It also survives a restart:
# the anime profile picks the saved mode up again on the next anime file.
# Alt+a cycles the mode, Alt+Shift+a overrides the anime detection by hand.

# الوضع A
CTRL+1 no-osd script-message-to profile_picker set-mode A

# الوضع B
CTRL+2 no-osd script-message-to profile_picker set-mode B

# الوضع C
CTRL+3 no-osd script-message-to profile_picker set-mode C

# الوضع A+A (تم التصحيح)
CTRL+4 no-osd script-message-to profile_picker set-mode A+A

# الوضع B+B (تم التصحيح)
CTRL+5 no-osd script-message-to profile_picker set-mode B+B

# الوضع C+A (تم التصحيح)
CTRL+6 no-osd script-message-to profile_picker set-mode C+A

# **----- اختصار لإلغاء جميع المؤثرات -----**
CTRL+0 no-osd script-message-to profile_picker set-mode off

# **----- Anime4K mode cycle / manual profile override -----**
# Ctrl+<letter> is a Windows control code, so it is the SAME key in every
# keyboard layout - unlike Alt+<letter>, which never matches while an
# Arabic layout is active (the key then produces an Arabic character).
# The mouse menu carries the same actions. toggle-manual sits on
# Ctrl+Shift+t (not g): under Arabic, Ctrl+Shift+G and Ctrl+Shift+H both
# arrive as Ctrl+أ (aliased), and that twin belongs to history.
Ctrl+g no-osd script-message-to profile_picker cycle-mode
Ctrl+Shift+t no-osd script-message-to profile_picker toggle-manual

# **----- Cheat sheet -----
# "?" is a punctuation key, so it works in every layout.
? no-osd script-message-to help_overlay help
F9 no-osd script-message-to help_overlay help
# Prevent accidental volume drop when pressing physical '/' without Shift
/ ignore


# **----- اختصارات مفيدة إضافية (تم التصحيح) -----**

# F1: أخذ لقطة شاشة (Screenshot) بدون تضمين الترجمة.
F1 no-osd screenshot video

# F2: أخذ لقطة شاشة مع تضمين الترجمة.
F2 no-osd screenshot

# F3: تفعيل/تعطيل فلتر إزالة الشرائط اللونية (Debanding).
F3 cycle deband

# F4: تفعيل/تعطيل سلاسة الحركة (Interpolation).
F4 cycle interpolation ; show-text "Motion Interpolation: ${interpolation}"

# Alt+t: التبديل بين محددات الحركة الزمنية (oversample حاد بدون تغبيش / linear ناعم)
Alt+t cycle-values tscale "oversample" "linear" ; show-text "Motion Scaler (tscale): ${tscale}"

# Ctrl+Alt+m: تفعيل/تعطيل محرك الحركة الذكي التلقائي (Smart Motion Engine)
Ctrl+Alt+m script-binding smart_motion/toggle

# F5: التبديل بين مسارات الصوت المتاحة.
F5 cycle audio

# F6: التبديل بين مسارات الترجمة المتاحة.
F6 cycle sub

# F7: إظهار/إخفاء الترجمة.
F7 cycle sub-visibility


# F8: تفعيل/تعطيل توحيد مستوى الصوت (Stable Volume / Night Mode)
# مفيد جداً في الأنمي والأفلام التي يكون فيها صوت الحوار منخفضاً والمؤثرات عالية
# f=500   : نافذة تحليل أطول = استجابة أهدأ، لا "تنفس" مسموع
# g=15    : أقصى رفع 15dB بدلاً من 31 — لا يضخم هسهسة الخلفية
# p=0.95  : هدف قمة قريب من المستوى الكامل، لا ضغط حاد نحو 50%
# m=10    : سقف لمعدل تغير الكسب لكل إطار — يقتل ضخّ الكسب المفاجئ
# alimiter: جدار حماية نهائي يمنع القص الرقمي عند رفع volume فوق 100%
F8 cycle-values af "lavfi=[dynaudnorm=f=500:g=15:p=0.95:m=10],lavfi=[alimiter=limit=0.9:level=false]" ""

# ── Window close ── ensure WM close button kills mpv instantly ──
CLOSE_WIN quit

# ── Mouse Bindings ── Restore classic right-click pause over native context menu
MBTN_RIGHT       cycle pause
MBTN_RIGHT_DBL   ignore

# Instant play from clipboard (with automatic URL normalization & instant OSD)
Ctrl+v           script-binding smart_paste/paste-to-open
Ctrl+V           script-binding smart_paste/paste-to-open
Ctrl+Shift+v     script-binding smart_paste/paste-to-playlist
Ctrl+Shift+V     script-binding smart_paste/paste-to-playlist

#######################################################################################
#                                   نهاية الإعدادات                                   #
